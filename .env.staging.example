COMPOSE_PROJECT_NAME=pricewatch-staging
# Copiar a .env.staging en el servidor y completar con valores reales.
NODE_ENV=production
ENVIRONMENT=staging

POSTGRES_DB=pricewatch_db
POSTGRES_USER=pricewatch_admin
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE

JWT_SECRET=CAMBIA_ESTE_SECRETO_MIN_32_CARACTERES
JWT_EXPIRES_IN=1h

ADMIN_EMAIL=admin@tu-dominio.cl
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN
DEMO_USER_EMAIL=user@tu-dominio.cl
DEMO_USER_PASSWORD=CAMBIA_ESTA_CLAVE_USER

FRONTEND_PORT=80
CORS_ORIGIN=https://staging.tu-dominio.cl,https://localhost,capacitor://localhost,http://localhost
STAGING_URL=https://staging.tu-dominio.cl
DEMO_PRODUCTS_SOURCE_ENABLED=false

IMAGE_PREFIX=ghcr.io/lurlopez/pricewatch
IMAGE_TAG=latest
